# Backend environment variables
# Copy to backend/.env and fill in values

PORT=3000
NODE_ENV=development

# Required — authentication will fail without this
JWT_SECRET=your-secure-random-secret-here

# Required — MongoDB connection string
# Local development (recommended for stability):
# MONGODB_URI=mongodb+srv://REDACTED:REDACTED@cluster.mongodb.net/eyeconic?retryWrites=true&w=majority

# Email (OTP / password reset)
# Primary: SMTP via Nodemailer (port 587 on Render paid plans)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Eyeconic Mentors
SMTP_FROM_EMAIL=no-reply@eyeconicmentors.com
# Secondary fallback: Resend API (HTTPS)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@eyeconicmentors.com

# Cloudinary (media uploads)
# Option A (production): full signed credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Option B (local dev): unsigned upload preset with cloud name only
CLOUDINARY_UPLOAD_PRESET=

# Firebase push notifications (use one of these)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
