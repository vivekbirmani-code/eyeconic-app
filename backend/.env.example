# Backend environment variables
# Copy to backend/.env and fill in values

PORT=3000
NODE_ENV=development

# Comma-separated browser origins allowed to call this API.
# Production web app:
# ALLOWED_ORIGINS=https://eyeconicmentors.vercel.app
# Local web development (non-production NODE_ENV includes localhost by default):
# ALLOWED_ORIGINS=https://eyeconicmentors.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Required — authentication will fail without this
JWT_SECRET=your-secure-random-secret-here

# Required — MongoDB connection string
# Local development (recommended for stability):
# MONGODB_URI=mongodb+srv://REDACTED:REDACTED@cluster.mongodb.net/eyeconic?retryWrites=true&w=majority

# Email (OTP / password reset)
# Primary: SMTP via Nodemailer (port 587 on Render paid plans)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Eyeconic Mentors
SMTP_FROM_EMAIL=no-reply@eyeconicmentors.com
# Secondary fallback: Resend API (HTTPS)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@eyeconicmentors.com

# ---- Public quiz guest flow (web + OTP leads) ----

# Web origin used for public quiz links. Generated links point DIRECTLY at
# this origin (/public-quiz/:token); legacy backend share URLs 302 here too.
# Resolution: explicit value > development fallback (http://localhost:5173)
# > production fallback (https://eyeconicmentors.vercel.app). Links ALWAYS
# open the web quiz — there is no app-redirect interstitial anymore.
# In production set this to the Render static site (eyeconic-public-web) URL
# — copy the exact URL from the Render dashboard; a bare host is fine (it is
# served over https). See docs/PUBLIC_WEB_DEPLOY.md.
# Example: WEB_APP_URL=https://eyeconic-public-web.onrender.com
WEB_APP_URL=

# Guest quiz OTPs are EMAIL OTPs — delivered through the SMTP/Resend
# configuration above (same provider chain as signup/password-reset mail).

# HMAC secret for hashing guest OTPs at rest (generate a random string).
# Falls back to JWT_SECRET when unset.
OTP_HASH_SECRET=

# Guest session token lifetime (guests who verified their email).
GUEST_JWT_EXPIRES_IN=4h

# Cloudinary (media uploads)
# Option A (production): full signed credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Option B (local dev): unsigned upload preset with cloud name only
CLOUDINARY_UPLOAD_PRESET=

# Firebase push notifications (use one of these)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
