# Web client environment variables (Vite)
# Copy to client/.env.local for local overrides, or set in your hosting provider.

# Development (npm run dev) — loaded from .env.development by default
# VITE_API_URL=http://localhost:3000/api
# VITE_SOCKET_URL=http://localhost:3000

# Production build (npm run build) — loaded from .env.production by default
# VITE_API_URL=https://eyeconic-app-prod-1r8o.onrender.com/api
# VITE_SOCKET_URL=https://eyeconic-app-prod-1r8o.onrender.com

# Vercel / CI: set VITE_API_URL and VITE_SOCKET_URL in the project settings.
# Do NOT point production at suspended or deprecated backends such as eyeconic-dev.onrender.com.
