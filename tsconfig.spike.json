{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "lib": ["ESNext", "DOM"]
  },
  "include": [
    "services/proctoringSpike/**/*.ts",
    "modules/proctoring-spike/src/**/*.ts",
    "app/(tabs)/quizzes/proctoring-spike.tsx"
  ]
}
