{
  "expo": {
    "name": "Eyeconic Mentorship",
    "slug": "neet-mentorship-app",
    "version": "1.0.1",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.png",
    "splash": {
      "image": "./assets/images/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#01b4ae"
    },
    "scheme": "mentorship",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eyeconicbydrlalla.mentorship",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app requires microphone access for voice calls",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ]
      },
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "package": "com.eyeconicbydrlalla.mentorship",
      "versionCode": 5,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "mentorship",
              "host": "quiz",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/Logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-av",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Eyeconic to access your camera",
          "microphonePermission": "Allow Eyeconic to access your microphone"
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withWakeUp"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b339dc67-5b70-425b-acd0-585b6954dd02"
      }
    }
  }
}