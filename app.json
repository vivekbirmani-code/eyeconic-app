{
  "expo": {
    "name": "Eyeconic Mentorship",
    "slug": "neet-mentorship-app",
    "version": "1.0.1",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.png",
    "splash": {
      "image": "./assets/images/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#01b4ae"
    },
    "scheme": "mentorship",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eyeconicbydrlalla.mentorship",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Microphone access is required so users can participate in live mentorship sessions, audio calls, and send voice messages.",
        "NSPhotoLibraryUsageDescription": "Photo library access is required so users can choose gallery images to share in chats.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false,
      "buildNumber": "9"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "package": "com.eyeconicbydrlalla.mentorship",
      "versionCode": 9,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "mentorship",
              "host": "quiz",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/Logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-av",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to select photos.",
          "cameraPermission": "Allow camera access."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Eyeconic to access your camera",
          "microphonePermission": "Microphone access is required so users can participate in live mentorship sessions, audio calls, and send voice messages."
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withWakeUp"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b339dc67-5b70-425b-acd0-585b6954dd02"
      }
    }
  }
}
