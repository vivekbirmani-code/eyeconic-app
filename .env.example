# Mobile app environment variables (Expo)
# Copy to .env in the project root for local development.

# Optional — override the development API URL (must include /api suffix or host only).
# Use your machine's LAN IP when testing on a physical device if Expo cannot infer it.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.42:3000/api
# EXPO_PUBLIC_API_URL=

# Optional — force environment in development builds (development | staging | production)
# EXPO_PUBLIC_APP_ENV=development

# Optional — override the Rank & Branch Predictor API URL (the Eyeconic
# website server, eyeconic-main repo — NOT the app backend). The default in
# EVERY environment is the deployed website server
# (https://eyeconic-server.vercel.app/api): the website server is a separate
# stack that is usually not running locally, so dev shares the deployment
# (it verifies the app JWT against the app backend — the same database dev
# sessions live in). Set this ONLY while developing the website server
# itself, pointing at your locally-running eyeconic-main server.
# Example: EXPO_PUBLIC_PREDICTOR_API_URL=http://10.0.2.2:5000/api
# EXPO_PUBLIC_PREDICTOR_API_URL=
